# ==========================================
# Variabel Lingkungan Digital-8-Bit (Contoh)
# Salin file ini menjadi .env.local dan isi nilai variabel berikut
# ==========================================

# 1. URL Web App Google Apps Script (GAS) untuk penyimpanan data kado
NEXT_PUBLIC_GAS_URL=https://script.google.com/macros/s/YOUR_GAS_DEPLOYMENT_ID/exec

# 2. ImgBB API Key untuk fitur upload foto kado (opsional, fallback ke direct link jika kosong)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here
